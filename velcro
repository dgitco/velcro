#!/bin/zsh
# velcro — keep network shares stuck to your Mac.
# Remounts SMB shares after Wi-Fi drops, sleep, or network changes. No popups.
emulate -L zsh
setopt pipe_fail

VERSION=0.2.0
SELF=${0:A}
LABEL=io.github.dgitco.velcro
CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/velcro
CONF=$CONF_DIR/mounts
PAUSE=$CONF_DIR/paused
LOG=$HOME/Library/Logs/velcro.log
PLIST=$HOME/Library/LaunchAgents/$LABEL.plist
BIN=$HOME/.local/bin/velcro
ICONS=$HOME/.local/share/velcro/icons
INTERVAL=60
SWIFTBAR_PLUGIN=velcro.10s.sh
# Field separator for scan output. Not a tab: read collapses repeated whitespace, losing empty fields.
SEP=$'\x1f'

log() { print -r -- "$(date '+%F %T') $*" >>"$LOG"; }

# Config lines: <smb url> [fallback host ...]
# e.g.  smb://me@nas.tailnet.ts.net/home
#       smb://me@192.168.1.10/media nas.tailnet.ts.net
entries() {
  [[ -r $CONF ]] || return 0
  grep -vE '^[[:space:]]*(#|$)' "$CONF"
}

# Split "smb://user@host/share" into globals: user host share (share stays URL-encoded).
parse() {
  local url=${1#smb://}
  user= host= share=
  if [[ $url == *@* ]]; then user=${url%%@*}; url=${url#*@}; fi
  host=${url%%/*}
  share=${url#*/}
  [[ -n $host && -n $share && $share != "$url" ]]
}

# Where is <share> mounted from any of <hosts...>? Prints the mount point.
# Reads `mount` output only; never touches the share, so a dead network can't hang it.
mountpoint_of() {
  local share=$1 h line; shift
  for h in "$@"; do
    line=$(mount -t smbfs | grep -iF -e "@$h/$share on " -e "//$h/$share on " | head -1)
    if [[ -n $line ]]; then
      line=${line#* on }
      print -r -- "${line% \(smbfs*}"
      return 0
    fi
  done
  return 1
}

reachable() { nc -z -G 2 "$1" 445 </dev/null >/dev/null 2>&1; }

# One line per share: state, share name, mount point, first host, config line (SEP-separated).
# state: mounted | reachable | offline. With "fast", unmounted shares are "offline" without probing.
scan() {
  local fast=$1 line state mp h
  local -a words hosts
  entries | while IFS= read -r line; do
    words=(${(z)line})
    parse "${words[1]}" || continue
    hosts=($host ${words[2,-1]})
    if mp=$(mountpoint_of "$share" $hosts); then
      state=mounted
    else
      state=offline mp=
      if [[ -z $fast ]]; then
        for h in $hosts; do reachable "$h" && { state=reachable; break; }; done
      fi
    fi
    print -r -- "$state$SEP${share//\%20/ }$SEP$mp$SEP$host$SEP$line"
  done
}

mount_share() {
  local url=$1
  # Errors go to the log, never to a dialog. A login prompt only appears if the keychain has no password.
  osascript -e 'on run argv' -e 'try' -e 'mount volume (item 1 of argv)' \
    -e 'on error m' -e 'log m' -e 'end try' -e 'end run' "$url" </dev/null >/dev/null 2>>"$LOG"
}

cmd_run() {
  [[ -e $PAUSE ]] && return 0
  # Don't stack login prompts if one is already waiting.
  pgrep -f "osascript.*mount volume" >/dev/null && return 0
  [[ -f $LOG && $(stat -f %z "$LOG") -gt 1048576 ]] && mv -f "$LOG" "$LOG.1"

  local line h tried=
  local -a words hosts
  entries | while IFS= read -r line; do
    words=(${(z)line})
    parse "${words[1]}" || { log "bad entry: $line"; continue; }
    hosts=($host ${words[2,-1]})
    mountpoint_of "$share" $hosts >/dev/null && continue
    for h in $hosts; do
      reachable "$h" || continue
      log "mount //$h/$share"
      mount_share "smb://${user:+$user@}$h/$share"
      tried=1
      break
    done
  done
  [[ -n $tried ]] && refresh_menubar
  return 0
}

cmd_status() {
  local st name mp h line state
  if launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1; then
    print "agent:  running (every ${INTERVAL}s + on network change)"
  else
    print "agent:  not installed  →  velcro install"
  fi
  [[ -e $PAUSE ]] && print "state:  paused  →  velcro resume" || print "state:  active"
  print
  scan | while IFS=$SEP read -r st name mp h line; do
    case $st in
      mounted)   state="● mounted" ;;
      reachable) state="◐ reachable, not mounted" ;;
      *)         state="○ offline" ;;
    esac
    printf '%-26s %s\n' "$state" "$line"
  done
  [[ -s $CONF ]] || print "no shares yet  →  velcro add smb://user@host/share"
}

cmd_add() {
  [[ -n $1 ]] || { print -u2 "usage: velcro add smb://user@host/share [fallback-host ...]"; return 2; }
  local url=${1// /%20}
  parse "$url" || { print -u2 "not an smb url: $1"; return 2; }
  mkdir -p "$CONF_DIR"
  if [[ -r $CONF ]] && grep -qF -- "$url" "$CONF"; then print "already added: $url"; return 0; fi
  print -r -- "$url${2:+ ${@[2,-1]}}" >>"$CONF"
  print "added: $url${2:+ (fallback: ${@[2,-1]})}"
  cmd_run
  refresh_menubar
}

cmd_rm() {
  [[ -n $1 && -r $CONF ]] || { print -u2 "usage: velcro rm <url or share name>"; return 2; }
  local pat=${1// /%20} tmp=$(mktemp)
  grep -vF -- "$pat" "$CONF" >"$tmp"
  if cmp -s "$tmp" "$CONF"; then rm -f "$tmp"; print -u2 "no match: $1"; return 1; fi
  mv "$tmp" "$CONF"
  refresh_menubar
  print "removed: $1  (still mounted? eject it in Finder)"
}

cmd_install() {
  mkdir -p "${BIN:h}" "${PLIST:h}" "${LOG:h}" "$CONF_DIR"
  [[ $SELF == "${BIN:A}" ]] || { cp -f "$SELF" "$BIN"; chmod +x "$BIN"; }
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$BIN</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>$INTERVAL</integer>
  <key>WatchPaths</key><array><string>/Library/Preferences/SystemConfiguration</string></array>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
  # bootout is asynchronous; wait until the old agent is gone
  local i; for i in {1..20}; do launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1 || break; sleep 0.25; done
  launchctl bootstrap "gui/$UID" "$PLIST" && print "installed: $BIN (agent $LABEL)"
  [[ :$PATH: == *:${BIN:h}:* ]] || print "note: add ${BIN:h} to your PATH"
  install_menubar
}

cmd_uninstall() {
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null
  rm -f "$PLIST" "$(swiftbar_dir)/$SWIFTBAR_PLUGIN"
  refresh_menubar
  print "agent and menu bar removed (config kept in $CONF_DIR)"
}

cmd_pause() {
  mkdir -p "$CONF_DIR"; : >"$PAUSE"
  refresh_menubar
  print "paused — eject shares in Finder; they won't come back until 'velcro resume'"
}
cmd_resume() { rm -f "$PAUSE"; print "resumed"; cmd_run; refresh_menubar; }
cmd_logs()   { [[ -f $LOG ]] && tail -n ${1:-30} "$LOG" || print "no log yet"; }

# --- menu bar (SwiftBar) ---------------------------------------------------

# SwiftBar's plugin folder, or its default if SwiftBar has never been configured.
swiftbar_dir() {
  local d=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null)
  print -r -- "${d:-$HOME/Library/Application Support/SwiftBar/Plugins}"
}

refresh_menubar() {
  [[ -e "$(swiftbar_dir)/$SWIFTBAR_PLUGIN" ]] && pgrep -xq SwiftBar &&
    open -g "swiftbar://refreshplugin?name=velcro" 2>/dev/null
  return 0
}

install_menubar() {
  local src=${SELF:h}/assets/logo/png
  if [[ -d $src ]]; then mkdir -p "$ICONS"; cp -f "$src"/*.png "$ICONS"/; fi
  if [[ ! -d /Applications/SwiftBar.app ]]; then
    print "menu bar: skipped — brew install --cask swiftbar, then velcro install"
    return 0
  fi
  local dir=$(swiftbar_dir)
  defaults read com.ameba.SwiftBar PluginDirectory >/dev/null 2>&1 ||
    defaults write com.ameba.SwiftBar PluginDirectory "$dir"
  mkdir -p "$dir"
  cat >"$dir/$SWIFTBAR_PLUGIN" <<EOF
#!/bin/zsh
# <xbar.title>velcro</xbar.title>
# <xbar.desc>Keep network shares stuck to your Mac</xbar.desc>
# <swiftbar.hideAbout>true</swiftbar.hideAbout>
# <swiftbar.hideRunInTerminal>true</swiftbar.hideRunInTerminal>
# <swiftbar.hideLastUpdated>true</swiftbar.hideLastUpdated>
# <swiftbar.hideDisablePlugin>true</swiftbar.hideDisablePlugin>
# <swiftbar.hideSwiftBar>true</swiftbar.hideSwiftBar>
exec "$BIN" swiftbar
EOF
  chmod +x "$dir/$SWIFTBAR_PLUGIN"
  if pgrep -xq SwiftBar; then refresh_menubar; else open -g -a SwiftBar; fi
  print "menu bar: $dir/$SWIFTBAR_PLUGIN"
}

# " <param>=<base64 png>" for one of velcro's icons, or nothing if it's missing.
icon() { [[ -r $ICONS/$1.png ]] && print -rn -- " $2=$(base64 -i "$ICONS/$1.png")"; }

# SwiftBar menu: plain text and velcro's own icons only.
cmd_swiftbar() {
  local -a rows words
  local row st name mp h line url paused= up=0 total bar
  [[ -e $PAUSE ]] && paused=1
  rows=("${(@f)$(scan fast)}")
  [[ -z ${rows[1]} ]] && rows=()
  total=${#rows}
  for row in $rows; do [[ $row == mounted$SEP* ]] && (( up++ )); done

  if [[ -n $paused ]]; then bar=paused
  elif (( total == 0 || up < total )); then bar=detached
  else bar=connected; fi

  print -r -- "|$(icon menubar-$bar templateImage)"
  print -- "---"
  print -r -- "velcro |$(icon app-18 image)"
  if [[ -n $paused ]]; then print -- "Paused | size=12 color=#8a8a8a"
  elif (( total == 0 )); then print -- "No shares yet | size=12 color=#8a8a8a"
  else print -- "$up of $total attached | size=12 color=#8a8a8a"; fi
  print -- "---"
  for row in $rows; do
    IFS=$SEP read -r st name mp h line <<<"$row"
    words=(${(z)line}); url=${words[1]}
    if [[ $st == mounted ]]; then print -r -- "$name |$(icon item-connected templateImage)"
    elif [[ -n $paused ]]; then print -r -- "$name |$(icon item-paused templateImage)"
    else print -r -- "$name |$(icon item-detached templateImage)"; fi
    print -r -- "--$h | size=11 color=#8a8a8a"
    if [[ $st == mounted ]]; then
      print -r -- "--Open in Finder | bash=/usr/bin/open param1=\"$mp\" terminal=false"
    else
      print -r -- "--Reconnect | bash=\"$BIN\" param1=run terminal=false refresh=true"
    fi
    print -r -- "--Remove from velcro | bash=\"$BIN\" param1=rm param2=\"$url\" terminal=false refresh=true"
  done
  (( total )) && print -- "---"
  if [[ -n $paused ]]; then
    print -r -- "Resume | bash=\"$BIN\" param1=resume terminal=false refresh=true"
  else
    print -r -- "Pause | bash=\"$BIN\" param1=pause terminal=false refresh=true"
    print -r -- "Reconnect now | bash=\"$BIN\" param1=run terminal=false refresh=true"
  fi
  print -r -- "Add share… | bash=\"$BIN\" param1=add-prompt terminal=false refresh=true"
  print -r -- "Open log | bash=/usr/bin/open param1=\"$LOG\" terminal=false"
}

# "Add share…" in the menu: ask for the address, then add it.
cmd_add_prompt() {
  local url
  url=$(osascript -e 'text returned of (display dialog "SMB address of the share" default answer "smb://user@host/share" with title "velcro" buttons {"Cancel", "Add"} default button "Add")' 2>/dev/null) || return 0
  [[ -n $url ]] && cmd_add ${(z)url} >>"$LOG" 2>&1
}

cmd_help() {
  cat <<EOF
velcro $VERSION — keep network shares stuck to your Mac

  velcro add smb://user@host/share [fallback-host ...]
  velcro rm <url|share>      stop tracking a share
  velcro status              what's mounted, reachable, paused
  velcro pause | resume      stop/start remounting (eject stays ejected)
  velcro install | uninstall background agent (every ${INTERVAL}s + network change)
                             and menu bar icon (needs SwiftBar)
  velcro run                 one pass now (what the agent calls)
  velcro logs [n]

config: $CONF
EOF
}

case ${1:-help} in
  run)         cmd_run ;;
  status|st)   cmd_status ;;
  add)         shift; cmd_add "$@" ;;
  add-prompt)  cmd_add_prompt ;;
  rm|remove)   shift; cmd_rm "$@" ;;
  install)     cmd_install ;;
  uninstall)   cmd_uninstall ;;
  pause)       cmd_pause ;;
  resume)      cmd_resume ;;
  logs|log)    shift; cmd_logs "$@" ;;
  swiftbar)    cmd_swiftbar ;;
  version|-v|--version) print "velcro $VERSION" ;;
  help|-h|--help) cmd_help ;;
  *) print -u2 "unknown command: $1"; cmd_help; exit 2 ;;
esac
