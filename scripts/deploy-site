#!/bin/zsh
# Publish velcro.dgit.co: the landing page in site/, the installer, and the release scripts/build-app made.
#
#   scripts/deploy-site            stage site/public, then wrangler deploy
#   scripts/deploy-site --stage    only stage (to try the installer against a local server)
#
# Uses the Cloudflare account that owns dgit.co (wrangler must be signed in to it).
set -e
root=${0:A:h:h}
version=$(sed -n 's/^VERSION=//p' $root/velcro)
zip=$root/build/velcro-$version.zip
pub=$root/site/public
[[ -f $zip ]] || { print -u2 "no $zip — run scripts/build-app first"; exit 1; }
cmp -s $root/velcro $root/build/velcro.app/Contents/Resources/velcro ||
  { print -u2 "build/velcro.app has an older velcro script — run scripts/build-app again"; exit 1; }

sha() { shasum -a 256 $1 | cut -d' ' -f1; }
rm -f $pub/velcro-*.zip(N)
cp $zip $pub/
# The command on its own, for: install | sh -s -- --cli-only, with the no-cache SHA-256 reader
# the app ships, so a command-line install verifies copies on shares the same way.
cp $root/velcro $pub/velcro
cp $root/build/velcro.app/Contents/MacOS/velcro-sha $pub/velcro-sha
# What the installer reads to know what to fetch and which checksums to expect.
print -l "version=$version" "zip=${zip:t}" "zip_sha256=$(sha $zip)" "cli_sha256=$(sha $root/velcro)" \
  "sha_tool_sha256=$(sha $pub/velcro-sha)" >$pub/latest
print "/download /${zip:t} 302" >$pub/_redirects
# The version search engines see in the page's structured data.
sed -i '' -E "s/\"softwareVersion\": *\"[^\"]*\"/\"softwareVersion\": \"$version\"/" $pub/index.html

# sitemap.xml: every page, dated by its last commit (today if it has none yet).
site=https://velcro.dgit.co
local -a pages urls
pages=($pub/index.html $pub/guides.html $pub/guides/*.html(N))
{
  print '<?xml version="1.0" encoding="UTF-8"?>'
  print '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'
  for f in $pages; do
    local rel=${${f#$pub}%.html} day=$(git -C $root log -1 --format=%cs -- $f 2>/dev/null)
    [[ $rel == /index ]] && rel=/
    urls+=($site$rel)
    print "  <url><loc>$site$rel</loc><lastmod>${day:-$(date +%F)}</lastmod></url>"
  done
  print '</urlset>'
} >$pub/sitemap.xml
print "staged velcro $version in $pub (${#urls} pages in sitemap.xml)"
[[ $1 == --stage ]] && exit 0

cd $root/site
CLOUDFLARE_ACCOUNT_ID=${CLOUDFLARE_ACCOUNT_ID:-a94e720e299d085a43f09d5ee6dddf74} wrangler deploy

# Tell IndexNow search engines (Bing, which ChatGPT and Copilot search on, Naver, Yandex, ...)
# what changed. The key is public by design: it's the file at /<key>.txt that proves the site is ours.
key=$(print $pub/*.txt(N) | xargs -n1 basename | grep -E '^[0-9a-f]{32}\.txt$' | head -1)
if [[ -n $key ]]; then
  key=${key%.txt}
  body=$(print -rn -- "{\"host\":\"velcro.dgit.co\",\"key\":\"$key\",\"keyLocation\":\"$site/$key.txt\",\"urlList\":[$(printf '"%s",' $urls | sed 's/,$//')]}")
  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST https://api.indexnow.org/indexnow \
    -H 'Content-Type: application/json; charset=utf-8' -d "$body")
  print "IndexNow: ${#urls} URLs, HTTP $code"
fi
