// velcro.dgit.co: static landing page, installer, and app download.
// Deploy: scripts/deploy-site (copies the release zip in, then wrangler deploy).
// worker.ts runs only for the install and download paths, to count them (privately, in D1).
{
  "name": "velcro-site",
  "account_id": "a94e720e299d085a43f09d5ee6dddf74",
  "compatibility_date": "2026-09-01",
  "main": "worker.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/latest", "/install", "/velcro", "/velcro-*.zip"]
  },
  "d1_databases": [
    { "binding": "STATS", "database_name": "dgit-stats", "database_id": "19fcfe2a-bbd7-433c-8a00-967c7c600a2b" }
  ],
  "routes": [{ "pattern": "velcro.dgit.co", "custom_domain": true }]
}
